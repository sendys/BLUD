@page "/Account/Register"
@model BLUDRSUD.Web.Pages.Account.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Registrasi";
}
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrasi &mdash; BLUD-RSUD SIK</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
</head>
<body class="min-h-full text-slate-800">
    <main class="min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-10">
        <div class="w-full max-w-5xl overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60 lg:grid lg:grid-cols-2">
            <section class="relative overflow-hidden bg-slate-900 px-7 py-10 text-white sm:px-12 sm:py-12 lg:flex lg:min-h-[680px] lg:flex-col lg:justify-between">
                <div class="absolute -right-20 -top-20 h-56 w-56 rounded-full border-[24px] border-emerald-500/10"></div>
                <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full border-[28px] border-emerald-400/10"></div>
                <div class="relative">
                    <div class="mb-12 flex items-center gap-3">
                        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-emerald-500 text-xl font-bold text-white shadow-lg shadow-emerald-950/30" aria-hidden="true">B</div>
                        <div>
                            <div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-emerald-300">BLUD-RSUD</div>
                            <div class="text-xs text-slate-300">Sistem Informasi Keuangan</div>
                        </div>
                    </div>
                    <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-emerald-300">Akses Terpercaya</p>
                    <h1 class="max-w-sm text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Mulai bekerja lebih terorganisir.</h1>
                    <p class="mt-5 max-w-sm text-sm leading-6 text-slate-300">Buat akun untuk mengakses pengelolaan keuangan BLUD-RSUD berbasis akuntansi akrual.</p>
                </div>
                <div class="relative mt-12 flex items-center gap-3 text-xs text-slate-400 lg:mt-0">
                    <span class="h-px w-8 bg-emerald-500"></span>
                    <span>PPK-BLUD <span class="mx-1 text-slate-600">&middot;</span> SAP Akrual</span>
                </div>
            </section>

            <section class="px-7 py-9 sm:px-12 sm:py-10 lg:flex lg:flex-col lg:justify-center">
                <div class="mb-7">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-600">Pendaftaran Pengguna</p>
                    <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Buat akun baru</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Lengkapi data berikut untuk mendapatkan akses ke sistem.</p>
                </div>

                <form id="registerForm" method="post">
                    <div asp-validation-summary="ModelOnly" class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.FullName" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-slate-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="7" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                            </span>
                            <input asp-for="Input.FullName" autocomplete="name" placeholder="Masukkan nama lengkap" autofocus class="block w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-11 pr-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10" />
                        </div>
                        <span asp-validation-for="Input.FullName" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Username" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-slate-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                            </span>
                            <input asp-for="Input.Username" autocomplete="username" placeholder="Pilih username" class="block w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-11 pr-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10" />
                        </div>
                        <span asp-validation-for="Input.Username" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-slate-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                            </span>
                            <input asp-for="Input.Email" type="email" autocomplete="email" placeholder="nama@instansi.go.id" class="block w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-11 pr-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10" />
                        </div>
                        <span asp-validation-for="Input.Email" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-slate-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                            </span>
                            <input id="passwordInput" asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="Minimal 8 karakter" class="block w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-11 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10" />
                            <button id="passwordToggle" type="button" class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-emerald-500" aria-label="Tampilkan password" aria-pressed="false">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div class="mb-6">
                        <label asp-for="Input.ConfirmPassword" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-slate-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4"/><rect x="4" y="4" width="16" height="16" rx="3"/></svg>
                            </span>
                            <input id="confirmPasswordInput" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Ulangi password" class="block w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-11 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10" />
                            <button id="confirmPasswordToggle" type="button" class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-emerald-500" aria-label="Tampilkan konfirmasi password" aria-pressed="false">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <button id="registerButton" type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm shadow-emerald-600/20 transition hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-500/20 active:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-70">
                        <span id="registerButtonLabel">Daftar</span>
                        <svg id="registerArrow" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
                    </button>
                </form>

                <p class="mt-7 text-center text-sm text-slate-500">Sudah memiliki akun? <a href="/Account/Login" class="font-semibold text-emerald-700 transition hover:text-emerald-800 hover:underline">Login</a></p>
                <p class="mt-8 text-center text-[11px] text-slate-400">&copy; 2026 BLUD-RSUD <span class="mx-1">&middot;</span> Sistem Informasi Keuangan</p>
            </section>
        </div>
    </main>

    <script>
        const registerForm = document.getElementById('registerForm');
        const registerButton = document.getElementById('registerButton');
        const registerButtonLabel = document.getElementById('registerButtonLabel');
        const registerArrow = document.getElementById('registerArrow');

        function configurePasswordToggle(toggleId, inputId) {
            const toggle = document.getElementById(toggleId);
            const input = document.getElementById(inputId);
            toggle.addEventListener('click', () => {
                const isVisible = input.type === 'text';
                input.type = isVisible ? 'password' : 'text';
                toggle.setAttribute('aria-label', isVisible ? 'Tampilkan password' : 'Sembunyikan password');
                toggle.setAttribute('aria-pressed', String(!isVisible));
            });
        }

        configurePasswordToggle('passwordToggle', 'passwordInput');
        configurePasswordToggle('confirmPasswordToggle', 'confirmPasswordInput');

        registerForm.addEventListener('submit', () => {
            registerButton.disabled = true;
            registerButtonLabel.textContent = 'Mendaftarkan...';
            registerArrow.classList.add('hidden');
        });
    </script>
</body>
</html>