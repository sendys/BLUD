@page
@model BLUDRSUD.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
    ViewData["Breadcrumb"] = "Error";
}
<div class="max-w-2xl mx-auto bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-red-700 mb-2">Terjadi Kesalahan</h2>
    <p class="text-sm text-slate-600 mb-4">Sistem tidak dapat memproses permintaan Anda. Silakan hubungi administrator.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-xs text-slate-400">Request ID: <code class="bg-slate-100 px-1.5 py-0.5 rounded">@Model.RequestId</code></p>
    }
</div>
