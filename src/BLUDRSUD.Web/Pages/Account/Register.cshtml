@page "/Account/Register"
@model BLUDRSUD.Web.Pages.Account.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Registrasi";
}
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrasi &mdash; BLUD-RSUD SIK</title>
    <link rel="stylesheet" href="~/lib/tailwind/tailwind.min.css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 py-8">
    <main class="w-full max-w-md">
        <section class="bg-white rounded-lg shadow-md border border-slate-200 p-8">
            <div class="text-center mb-6">
                <div class="text-xs uppercase tracking-wide text-slate-400">Sistem Informasi Keuangan</div>
                <div class="text-2xl font-semibold text-slate-800">BLUD-RSUD</div>
                <div class="text-xs text-slate-500">PPK-BLUD &middot; SAP Akrual</div>
            </div>

            <div class="text-center mb-6">
                <h1 class="text-xl font-semibold text-slate-800">Buat Akun</h1>
                <p class="text-sm text-slate-500 mt-1">Daftarkan akun untuk mengakses BLUD RSUD</p>
            </div>

            <form method="post" onsubmit="setSubmitting(this)">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>

                <div class="mb-4">
                    <label asp-for="Input.FullName" class="block text-sm font-medium text-slate-700 mb-1"></label>
                    <input asp-for="Input.FullName" autocomplete="name" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-emerald-500" autofocus />
                    <span asp-validation-for="Input.FullName" class="text-red-600 text-xs"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.Username" class="block text-sm font-medium text-slate-700 mb-1"></label>
                    <input asp-for="Input.Username" autocomplete="username" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                    <span asp-validation-for="Input.Username" class="text-red-600 text-xs"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 mb-1"></label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                    <span asp-validation-for="Input.Email" class="text-red-600 text-xs"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1"></label>
                    <div class="flex">
                        <input asp-for="Input.Password" type="password" autocomplete="new-password" class="flex-1 min-w-0 px-3 py-2 border border-slate-300 rounded-l focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                        <button type="button" onclick="togglePassword('Input_Password', this)" class="px-3 border border-l-0 border-slate-300 rounded-r text-xs text-slate-600 hover:bg-slate-50" aria-label="Tampilkan password">Lihat</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-600 text-xs"></span>
                </div>
                <div class="mb-5">
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1"></label>
                    <div class="flex">
                        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" class="flex-1 min-w-0 px-3 py-2 border border-slate-300 rounded-l focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                        <button type="button" onclick="togglePassword('Input_ConfirmPassword', this)" class="px-3 border border-l-0 border-slate-300 rounded-r text-xs text-slate-600 hover:bg-slate-50" aria-label="Tampilkan konfirmasi password">Lihat</button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-xs"></span>
                </div>

                <button id="registerButton" type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded transition">Daftar</button>
            </form>

            <p class="text-center text-sm text-slate-500 mt-5">
                Sudah memiliki akun? <a href="/Account/Login" class="font-medium text-emerald-700 hover:text-emerald-800">Login</a>
            </p>
        </section>
    </main>

    <script>
        function togglePassword(id, button) {
            const input = document.getElementById(id);
            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            button.textContent = visible ? 'Lihat' : 'Sembunyikan';
            button.setAttribute('aria-label', visible ? 'Tampilkan password' : 'Sembunyikan password');
        }

        function setSubmitting(form) {
            const button = form.querySelector('#registerButton');
            button.disabled = true;
            button.textContent = 'Mendaftarkan...';
            button.classList.add('opacity-75', 'cursor-not-allowed');
        }
    </script>
</body>
</html>
