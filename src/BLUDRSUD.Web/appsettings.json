{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=blud_rsud_dev;User=root;Password=bismillah;Charset=utf8mb4;AllowUserVariables=true;"
  },
  "Logging": {
    "EnableSensitiveDataLogging": {},
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/bludrsud-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "Seed": {
    "ApplyOnStartup": false
  },
  "AllowedHosts": "*"
}
