@page "/Account/Login"
@model BLUDRSUD.Web.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login &mdash; BLUD-RSUD SIK</title>
    <link rel="stylesheet" href="~/lib/tailwind/tailwind.min.css" />
</head>
<body class="h-full flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-lg shadow-md border border-slate-200 p-8">
            <div class="text-center mb-6">
                <div class="text-xs uppercase tracking-wide text-slate-400">Sistem Informasi Keuangan</div>
                <div class="text-2xl font-semibold text-slate-800">BLUD-RSUD</div>
                <div class="text-xs text-slate-500">PPK-BLUD &middot; SAP Akrual</div>
            </div>

            <form method="post">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="text-emerald-700 bg-emerald-50 border border-emerald-200 rounded p-3 text-sm mb-4">@Model.SuccessMessage</div>
                }
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Input.Username" class="block text-sm font-medium text-slate-700 mb-1">Username</label>
                    <input asp-for="Input.Username" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-emerald-500" autofocus />
                    <span asp-validation-for="Input.Username" class="text-red-600 text-xs"></span>
                </div>
                <div class="mb-5">
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                    <input asp-for="Input.Password" type="password" class="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                    <span asp-validation-for="Input.Password" class="text-red-600 text-xs"></span>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded transition">Masuk</button>
                <input type="hidden" asp-for="ReturnUrl" />
            </form>
            <p class="text-center text-sm text-slate-500 mt-5">
                Belum memiliki akun? <a href="/Account/Register" class="font-medium text-emerald-700 hover:text-emerald-800">Daftar</a>
            </p>
        </div>
        <p class="text-center text-[11px] text-slate-400 mt-4">
            Default admin: <code>admin</code> / <code>Blud@2026!</code> &mdash; ganti segera setelah login.
        </p>
    </div>
</body>
</html>
